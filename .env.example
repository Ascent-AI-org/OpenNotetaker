# ── OpenNotetaker configuration ──────────────────────────────────────────────
# One file, two run modes:
#
#   npm run dev            local demo — works with this file untouched (no keys)
#   docker compose up -d   real recordings — set the three REQUIRED values below
#
# Container-specific values (Chromium path, PulseAudio sink, internal URLs) are
# pinned inside docker-compose.yml, so nothing you set here for local development
# can break the containers.

# ── REQUIRED for real recordings (docker compose) ─────────────────────────────
# 1. Speech-to-text: https://console.deepgram.com → API key
DEEPGRAM_API_KEY=
# 2. Notes/normalization LLM: https://aistudio.google.com → API key
#    (or set LLM_PROVIDER=openai and OPENAI_API_KEY instead)
LLM_PROVIDER=mock
GEMINI_API_KEY=
# 3. Shared secret between the web app and recording workers.
#    Generate one: openssl rand -hex 32
RUNNER_TOKEN=

# ── OPTIONAL: Google integration (email delivery, calendar autojoin, login) ──
# Create an OAuth client in Google Cloud Console (see README → Google setup).
# Redirect URI must be <your base URL>/api/gmail/oauth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/api/gmail/oauth/callback
GOOGLE_GMAIL_TOKEN_PATH=data/google-gmail-token.json

# Public base URL of the app. Behind a TLS proxy set https://... — this also turns
# secure cookies on. Workers in docker compose use the internal URL instead.
OPENNOTETAKER_BASE_URL=http://127.0.0.1:5173

# How long an automatic action-item email is held after the notes are ready. Action
# items are LLM output and some are wrong, so this is the window to edit or cancel
# before the mail leaves. 0 sends as soon as the notes are ready.
ACTION_ITEMS_HOLD_MINUTES=10

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5173
HOST=127.0.0.1

# Reverse proxies in front of this server, if any. Login, signup, and export rate
# limits are keyed on the client address, so this has to be right:
#   0  no proxy — the socket address is the client (default, safe)
#   1  one proxy you control, e.g. a single Caddy or nginx doing TLS
# Too low and every request looks like it came from the proxy, so the whole team
# shares one bucket and one person's retries lock everyone out. Too high and a
# client can forge the address by sending its own X-Forwarded-For. Count the hops.
TRUST_PROXY_HOPS=0

# Accounts and sessions. Sessions use HttpOnly cookies; secure cookies default on
# when OPENNOTETAKER_BASE_URL is https. The first account to sign up becomes the
# admin. Set AUTH_ALLOW_SIGNUPS=false after your team is in (admins can still invite).
AUTH_ALLOW_SIGNUPS=true
AUTH_SESSION_TTL_DAYS=14
AUTH_SECURE_COOKIES=

# ── Speech-to-text tuning ─────────────────────────────────────────────────────
STT_PROVIDER=deepgram
DEEPGRAM_MODEL=nova-3
# "multi" is the whole point: code-switched Hindi-English in one stream.
DEEPGRAM_LANGUAGE=multi
# Comma-separated hints for names, products, and recurring jargon. Add your
# teammates' names — it noticeably improves Hinglish name recognition. Keyterm
# prompting works with language=multi on nova-3; keep the list under ~100 words.
DEEPGRAM_KEYTERMS=OpenNotetaker,Google Meet,Hinglish
# Optional raw Deepgram query string for experiments. Overrides built-in defaults,
# for example: endpointing=500 (the built-in default is endpointing=300).
DEEPGRAM_EXTRA_PARAMS=

# ── LLM tuning ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_NORMALIZE_CHUNK_SIZE=18
GEMINI_RECONSTRUCT_CHUNK_SIZE=48
# Notes extraction chunk size (turns/segments). Meetings longer than this are
# summarized chunk-by-chunk and merged so one huge request can't time out.
GEMINI_NOTES_CHUNK_SIZE=200
GEMINI_REQUEST_TIMEOUT_MS=90000
# Retries per Gemini request on transient failures (timeout, 429, 5xx). Long meetings
# make dozens of calls; retrying a rare slow chunk keeps finalization from failing.
GEMINI_MAX_RETRIES=2

# ── Bot capture provider ──────────────────────────────────────────────────────
#   demo     - runs the Hinglish sample pipeline, no external services.
#   external - the web app spawns one runner child process per meeting.
#   fleet    - recording workers claim jobs over the API (what docker compose runs;
#              scale with: docker compose up -d --scale open-notetaker-worker=3).
BOT_PROVIDER=demo

# Fleet job leasing: how long a worker claim survives without API activity, and how
# often idle workers poll for new jobs.
RUNNER_LEASE_SECONDS=120
RUNNER_POLL_SECONDS=5
# Stable worker name in logs/events (defaults to hostname-pid).
WORKER_ID=

# ── Bot browser (local development; docker-compose.yml pins its own values) ───
BOT_DISPLAY_NAME=OpenNotetaker - Recording
BOT_CHROME_CHANNEL=chrome
BOT_CHROME_EXECUTABLE_PATH=
BOT_CHROME_USER_DATA_DIR=.bot-profile
# direct, cdp, rawcdp, or applescript. Use rawcdp/applescript only for local prototyping.
BOT_CHROME_LAUNCH_MODE=rawcdp
BOT_CHROME_EXTRA_ARGS=
BOT_HEADLESS=false
BOT_MAX_DURATION_MINUTES=120
BOT_ALONE_TIMEOUT_SECONDS=45

# Audio capture for a local (non-docker) runner. Linux: pulse. macOS testing only:
# avfoundation with a loopback device.
FFMPEG_PATH=ffmpeg
AUDIO_CAPTURE_DRIVER=pulse
AUDIO_CAPTURE_SOURCE=default

# ── Video recording ───────────────────────────────────────────────────────────
# Off by default, and that is deliberate: turning this on starts writing video of
# people's faces to disk, and upgrading a deployment must never do that on its own.
# Once it is true, every new meeting records unless whoever creates it unticks the
# box — so settle the consent question before you flip it, not after.
VIDEO_RECORDING_ENABLED=false
# Whether that per-meeting box starts ticked. Set it false to make video opt-in per
# meeting instead of opt-out; the operator switch above still gates everything.
VIDEO_RECORD_BY_DEFAULT=true

# Days a recording is kept — a ceiling, not an extension. The effective window is
# min(this, the meeting's own retention), so video is always gone by the time the
# transcript is, never after. Raising it above a meeting's retention buys nothing.
VIDEO_RETENTION_DAYS=7

# Disk. Video is the only artifact here big enough to fill a volume: roughly
# 1.5-3 MB per minute, so a 48-minute meeting is 70-150 MB and a busy week is a few
# GB. Over the budget, the oldest recordings are evicted first; one recording stops
# at VIDEO_MAX_MB. MIN_FREE_DISK_GB is the harder floor — capture refuses to start
# below it, because a full disk also means meetings.json cannot be rewritten, and
# that takes transcription down with it. Keep the budget comfortably under the size
# of the volume, not equal to it: eviction runs after the write, not before.
VIDEO_DISK_BUDGET_GB=20
VIDEO_MAX_MB=2048
VIDEO_MIN_FREE_DISK_GB=5

# Clips: the longest one anybody can cut, and how long a public share link lives
# when the person sharing does not pick an expiry. Only the hash of a share token is
# stored, so the link is shown exactly once and cannot be recovered afterwards —
# short expiries are cheap, because a link that has expired cannot leak later.
VIDEO_MAX_CLIP_SECONDS=300
VIDEO_SHARE_DEFAULT_DAYS=7

# Capture for a local (non-docker) runner; docker-compose.yml pins its own values.
# x11grab reads the virtual display the bot's Chrome draws on. On macOS use
# avfoundation with a screen-capture index. VIDEO_SIZE must match that display:
# larger gives black bars, smaller silently crops the call out of frame.
VIDEO_CAPTURE_DRIVER=x11grab
VIDEO_CAPTURE_SOURCE=:99
VIDEO_SIZE=1280x720
# Frame rate and H.264 quality. A meeting is mostly still faces and shared slides,
# so 15fps at CRF 30 is chosen, not lazy: every step up in frame rate or down in CRF
# multiplies the file and the worker CPU that the audio capture feeding
# transcription is competing for. Recording video must never cost you a transcript.
VIDEO_FRAMERATE=15
VIDEO_CRF=30
VIDEO_PRESET=veryfast

# ── Transcript email delivery ─────────────────────────────────────────────────
# Recipients and auto-email are per-user settings in the UI; these are operator
# fallbacks for single-user/local use.
TRANSCRIPT_EMAIL_TO=
TRANSCRIPT_EMAIL_FROM=
TRANSCRIPT_EMAIL_ENABLED=false

# ── Google Calendar sync (operator switches; users opt in per account in the UI) ─
GOOGLE_CALENDAR_SYNC_ENABLED=false
GOOGLE_CALENDAR_AUTOSTART_ENABLED=false
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_POLL_SECONDS=60
GOOGLE_CALENDAR_LOOKAHEAD_MINUTES=120
GOOGLE_CALENDAR_AUTOSTART_LEAD_MINUTES=2
GOOGLE_CALENDAR_AUTOSTART_LATE_MINUTES=30
GOOGLE_CALENDAR_RETENTION_DAYS=30
